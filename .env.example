# --- 数据库 ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_creative

# --- LLM ---
# 生产运行请使用真实供应商；也可以登录后在“LLM 大模型配置”页面保存用户配置。
# openai / deepseek / siliconflow / zhipu / moonshot / qwen / yi / minimax / custom
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# 仅自动化测试使用；生产环境保持 false。
ALLOW_MOCK_PROVIDER=false

# --- RAG / Embedding ---
# openai = 需要 EMBEDDING_API_KEY
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# --- LangGraph ---
# true = 使用 PostgreSQL 持久化 checkpoint
LANGGRAPH_CHECKPOINT_DB=false

# --- Langfuse / Observability ---
# true = 启用 Langfuse LLM tracing（需配置 public/secret key）
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_CAPTURE_PROMPTS=true

# --- 应用 ---
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,null
MAX_UPLOAD_BYTES=5242880
MAX_TXT_IMPORT_BYTES=52428800

# --- 日志 ---
# 日志级别：DEBUG | INFO | WARNING | ERROR | CRITICAL
# 当 DEBUG=true 时默认 LOG_LEVEL=DEBUG
LOG_LEVEL=DEBUG
# 可选：将日志写入文件（按大小轮转，单个文件 10MB，保留 5 个备份）
# LOG_FILE=logs/app.log
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5
