# --- 数据库 ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_creative

# --- LLM ---
# 生产运行请使用真实供应商；也可以登录后在“LLM 大模型配置”页面保存用户配置。
# openai / deepseek / siliconflow / zhipu / moonshot / qwen / yi / minimax / custom
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# 仅自动化测试使用；生产环境保持 false。
ALLOW_MOCK_PROVIDER=false

# --- RAG / Embedding ---
# openai = 需要 EMBEDDING_API_KEY
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# --- LangGraph ---
# true = 使用 PostgreSQL 持久化 checkpoint
LANGGRAPH_CHECKPOINT_DB=false

# --- Langfuse / Observability ---
# true = 启用 Langfuse LLM tracing（需配置 public/secret key）
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_CAPTURE_PROMPTS=true

# --- 应用 ---
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,null
MAX_UPLOAD_BYTES=5242880
MAX_TXT_IMPORT_BYTES=52428800

# --- 日志 ---
# 日志级别：DEBUG | INFO | WARNING | ERROR | CRITICAL
# 当 DEBUG=true 时默认 LOG_LEVEL=DEBUG
LOG_LEVEL=DEBUG
# 可选：将日志写入文件（按大小轮转，单个文件 10MB，保留 5 个备份）
# LOG_FILE=logs/app.log
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5

# --- 运行环境与安全（任务 0.2） ---
# development（默认）或 production。production 下：缺 JWT_SECRET(>=32位) 或 ENCRYPTION_KEY 启动即失败，
# 默认关闭注册与首次登录自动建号，账号用 `python scripts/create_admin.py` 创建。
APP_ENV=development
# 加密用户 API Key 的 Fernet 密钥，生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# 留空则按 APP_ENV 推导默认值（开发 true / 生产 false）
ALLOW_REGISTRATION=
ALLOW_FIRST_USER_BOOTSTRAP=

# --- 登录/注册限流（任务 0.3+0.4） ---
# 同一 IP 对登录与注册的每分钟总次数上限
AUTH_IP_RATE_LIMIT_PER_MINUTE=20
# 反向代理层数。0（默认）= 忽略 X-Forwarded-For，只用 TCP 对端地址。
# 部署在 N 层自己控制的代理后面时必须设为 N，否则所有用户会共用代理的 IP，共享同一个每分钟配额。
TRUSTED_PROXY_COUNT=0

# --- /media 鉴权 Cookie（任务 0.5） ---
# media_token Cookie 是否加 Secure 属性。留空按 APP_ENV 推导（生产 true / 开发 false）；
# 本地用 http://localhost 时必须为 false，否则浏览器不会回传该 Cookie，图片会 401。
COOKIE_SECURE=

# --- 请求体大小限制（任务 0.6） ---
# 通用请求体上限（字节），默认 10MB。上传类接口有各自更高的专项上限：
# 图片 5MB、TXT 导入 50MB、知识库上传 50MB（见 backend/api/body_limit.py 的规则表）。
MAX_REQUEST_BODY_BYTES=10485760

# --- 出站请求 SSRF 过滤（任务 0.7） ---
# 用户填写的模型地址/搜索服务地址是否允许指向回环、私网、链路本地地址。
# 留空按 APP_ENV 推导（开发 true / 生产 false）；桌面端固定为 true（要连本机 Ollama）。
# 注意：云元数据地址（169.254.169.254）与网页正文抓取始终禁止内网。
ALLOW_PRIVATE_LLM_ENDPOINTS=
# 抓取网页正文的单次响应体上限（字节），默认 2MB
WEB_FETCH_MAX_BYTES=2097152
# 网页抓取的最大重定向跳数，默认 3
WEB_FETCH_MAX_REDIRECTS=3

# 网页抓取是否遵循系统代理（HTTP_PROXY/HTTPS_PROXY）。
# 开发/桌面端默认 true，生产默认 false。生产设 true = 信任运维配置的出网代理，
# 但会失去“把连接钉在校验过的 IP 上”的能力（DNS 由代理解析，防不住 DNS 重绑定）。
WEB_FETCH_TRUST_ENV_PROXY=
